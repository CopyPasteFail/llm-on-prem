{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "llm-serving values",
  "type": "object",
  "required": ["litellm", "vllm", "ingress"],
  "properties": {
    "litellm": {
      "type": "object",
      "required": ["image", "port", "servedModelName", "existingSecret", "probes"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "servedModelName": {"type": "string", "minLength": 1},
        "replicaCount": {"type": "integer", "const": 1},
        "image": {"$ref": "#/definitions/image"},
        "probes": {"$ref": "#/definitions/litellmProbes"},
        "existingSecret": {
          "type": "object",
          "required": ["name", "masterKeyKey", "vllmApiKeyKey"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "masterKeyKey": {"type": "string", "minLength": 1},
            "vllmApiKeyKey": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "vllm": {
      "type": "object",
      "required": ["image", "replicaCount", "port", "resources", "model", "modelCache", "deployment", "probes"],
      "properties": {
        "replicaCount": {"type": "integer", "const": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "image": {"$ref": "#/definitions/image"},
        "resources": {
          "type": "object",
          "required": ["limits"],
          "properties": {
            "limits": {
              "type": "object",
              "required": ["nvidia.com/gpu"],
              "properties": {
                "nvidia.com/gpu": {"const": 1}
              }
            }
          }
        },
        "probes": {"$ref": "#/definitions/vllmProbes"},
        "modelCache": {
          "type": "object",
          "required": ["create", "claimName", "existingClaim", "accessModes", "size", "mountPath"],
          "properties": {
            "create": {"type": "boolean"},
            "claimName": {"type": "string", "minLength": 1},
            "existingClaim": {"type": "string"},
            "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "size": {"type": "string", "minLength": 1},
            "storageClassName": {"type": "string"},
            "mountPath": {"type": "string", "minLength": 1}
          },
          "allOf": [
            {
              "if": {"properties": {"create": {"const": false}}},
              "then": {"properties": {"existingClaim": {"minLength": 1}}}
            }
          ]
        },
        "deployment": {
          "type": "object",
          "required": ["strategy"],
          "properties": {"strategy": {"type": "string", "enum": ["Recreate"]}}
        },
        "model": {
          "type": "object",
          "required": ["id", "revision", "dtype", "trustRemoteCode", "maxModelLen", "gpuMemoryUtilization", "maxNumSeqs", "maxNumBatchedTokens", "downloadDir"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "tokenizer": {"type": "string"},
            "tokenizerRevision": {"type": "string"},
            "dtype": {"type": "string", "minLength": 1},
            "quantization": {"type": "string"},
            "trustRemoteCode": {"const": false},
            "maxModelLen": {"type": "integer", "minimum": 1},
            "gpuMemoryUtilization": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "maxNumSeqs": {"type": "integer", "minimum": 1},
            "maxNumBatchedTokens": {"type": "integer", "minimum": 1},
            "downloadDir": {"type": "string", "minLength": 1},
            "extraArgs": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "host"],
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string", "minLength": 1}
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "litellmProbes": {
      "type": "object",
      "required": ["readiness", "liveness"],
      "properties": {
        "readiness": {"$ref": "#/definitions/probeWindow"},
        "liveness": {"$ref": "#/definitions/livenessProbeWindow"}
      }
    },
    "vllmProbes": {
      "type": "object",
      "required": ["startup", "readiness", "liveness"],
      "properties": {
        "startup": {"$ref": "#/definitions/probeWindow"},
        "readiness": {"$ref": "#/definitions/probeWindow"},
        "liveness": {"$ref": "#/definitions/livenessProbeWindow"}
      }
    },
    "probeWindow": {
      "type": "object",
      "required": ["periodSeconds", "failureThreshold"],
      "properties": {
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "livenessProbeWindow": {
      "type": "object",
      "required": ["initialDelaySeconds", "periodSeconds", "failureThreshold"],
      "properties": {
        "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    }
  }
}
